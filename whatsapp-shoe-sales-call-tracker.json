    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "phoneNumber", "type": "string", "value": "={{ $json.phoneNumber }}" },
            { "id": "2", "name": "clientName", "type": "string", "value": "={{ $json.clientName }}" },
            { "id": "3", "name": "waMessageId", "type": "string", "value": "={{ $json.waMessageId }}" },
            { "id": "4", "name": "messageType", "type": "string", "value": "={{ $json.messageType }}" },
            { "id": "5", "name": "messageText", "type": "string", "value": "={{ $json.messageText }}" },
            { "id": "6", "name": "sharedLocation", "type": "string", "value": "={{ $json.sharedLocation }}" },
            { "id": "7", "name": "dateISO", "type": "string", "value": "={{ DateTime.fromSeconds(Number($json.waTimestampUnix)).toFormat('yyyy-LL-dd') }}" },
            { "id": "8", "name": "timeHM", "type": "string", "value": "={{ DateTime.fromSeconds(Number($json.waTimestampUnix)).toFormat('HH:mm:ss') }}" }
          ]
        },
        "options": {}
      },
      "id": "node-normalize",
      "name": "Normalize Common Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1240, -100]
    },
    {
      "parameters": {
        "operation": "search",
        "documentId": { "__rl": true, "mode": "list", "value": "REPLACE_ME_SPREADSHEET_ID" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Sales Call Log" },
        "filtersUI": {
          "values": [
            { "lookupColumn": "Phone Number", "lookupValue": "={{ $json.phoneNumber }}" }
          ]
        },
        "options": {}
      },
      "id": "node-count-calls",
      "name": "Count Previous Calls",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1480, -100],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const previousCalls = $input.all().length;\nconst current = $('Normalize Common Fields').first().json;\n\nreturn [{\n  json: {\n    ...current,\n    sequenceNumber: previousCalls + 1\n  }\n}];"
      },
      "id": "node-sequence",
      "name": "Compute Sequence Number",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1720, -100]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": { "__rl": true, "mode": "list", "value": "gpt-4o-mini" },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You help a wholesale shoe seller log WhatsApp sales conversations. From the client's message, extract strict JSON with these keys only: product_interest (shoe type/model/brand mentioned, or \"unspecified\"), quantity (requirement like pairs/cartons, or \"unspecified\"), location (city/area mentioned in the text, or \"unspecified\"), interest_level (\"High\", \"Medium\", or \"Low\"), follow_up_needed (\"Yes\" or \"No\"), summary (one short sentence). Respond with ONLY the JSON object, no markdown."
            },
            {
              "role": "user",
              "content": "={{ $json.messageText }}"
            }
          ]
        },
        "options": { "responseFormat": "json_object" }
      },
      "id": "node-ai-extract",
      "name": "Extract Sales Details (AI)",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.8,
      "position": [1960, -100],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_ME",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const source = $('Compute Sequence Number').item.json;\n\nlet parsed = {};\ntry {\n  const raw = $json.message?.content ?? $json.content ?? $json.text ?? '{}';\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parsed = {};\n}\n\nreturn {\n  json: {\n    ...source,\n    productInterest: parsed.product_interest || 'unspecified',\n    quantity: parsed.quantity || 'unspecified',\n    location: source.sharedLocation || parsed.location || 'unspecified',\n    interestLevel: parsed.interest_level || 'Low',\n    followUpNeeded: parsed.follow_up_needed || 'No',\n    summary: parsed.summary || source.messageText\n  }\n};"
      },
      "id": "node-parse-ai",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2200, -100]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "mode": "list", "value": "REPLACE_ME_SPREADSHEET_ID" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Sales Call Log" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{ $json.dateISO }}",
            "Time": "={{ $json.timeHM }}",
            "Client Name": "={{ $json.clientName }}",
            "Phone Number": "={{ $json.phoneNumber }}",
            "Location": "={{ $json.location }}",
            "Sequence No": "={{ $json.sequenceNumber }}",
            "Message Type": "={{ $json.messageType }}",
            "Message": "={{ $json.messageText }}",
            "Product Interest": "={{ $json.productInterest }}",
            "Quantity/Requirement": "={{ $json.quantity }}",
            "Interest Level": "={{ $json.interestLevel }}",
            "Follow-up Needed": "={{ $json.followUpNeeded }}",
            "Summary": "={{ $json.summary }}",
            "WA Message ID": "={{ $json.waMessageId }}"
          }
        },
        "options": {}
      },
      "id": "node-append-log",
      "name": "Append to Sales Call Log",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [2440, -100],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "mode": "list", "value": "REPLACE_ME_SPREADSHEET_ID" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Client Master" },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["Phone Number"],
          "value": {
            "Phone Number": "={{ $json.phoneNumber }}",
            "Client Name": "={{ $json.clientName }}",
            "Location": "={{ $json.location }}",
            "Last Contact Date": "={{ $json.dateISO }}",
            "Last Product Interest": "={{ $json.productInterest }}",
            "Interest Level": "={{ $json.interestLevel }}",
            "Status": "={{ $json.interestLevel === 'High' ? 'Hot Lead' : ($json.followUpNeeded === 'Yes' ? 'Needs Follow-up' : 'Contacted') }}"
          }
        },
        "options": {}
      },
      "id": "node-upsert-client",
      "name": "Upsert Client Master",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [2680, -100],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.interestLevel }}",
              "rightValue": "High",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-high",
      "name": "Is High Interest?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2920, -100]
    },
    {
      "parameters": {
        "sendTo": "003macid@gmail.com",
        "subject": "=Hot Lead: {{ $json.clientName }} wants {{ $json.productInterest }}",
        "message": "=New high-interest WhatsApp sales call logged.\n\nClient: {{ $json.clientName }}\nPhone: {{ $json.phoneNumber }}\nLocation: {{ $json.location }}\nDate/Time: {{ $json.dateISO }} {{ $json.timeHM }}\nProduct Interest: {{ $json.productInterest }}\nQuantity/Requirement: {{ $json.quantity }}\nSummary: {{ $json.summary }}\nFollow-up needed: {{ $json.followUpNeeded }}\n\nThis is call/message #{{ $json.sequenceNumber }} logged for this client.",
        "options": {}
      },
      "id": "node-notify",
      "name": "Notify Sales Owner",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [3160, -220],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_ME",
          "name": "Gmail account"
        }
      }
    }
  ],
