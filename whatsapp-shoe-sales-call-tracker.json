            { "id": "5", "name": "messageType", "type": "string", "value": "text" },
            { "id": "6", "name": "messageText", "type": "string", "value": "={{ $json.text.body }}" },
            { "id": "7", "name": "sharedLocation", "type": "string", "value": "" }
          ]
        },
        "options": {}
